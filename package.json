{
  "name": "clipboard-saver",
  "version": "1.0.0",
  "description": "自动将系统剪贴板的新内容（附带时间戳）追加到当前打开的笔记末尾。",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "clipboard"
  ],
  "author": "WorkBuddy",
  "license": "MIT",
  "devDependencies": {
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.21.5",
    "obsidian": "^1.7.2",
    "tslib": "^2.6.3",
    "typescript": "^5.5.3"
  }
}
